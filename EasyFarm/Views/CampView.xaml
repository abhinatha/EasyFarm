<UserControl x:Class="EasyFarm.Views.CampView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="271"
             d:DesignWidth="442">
    <UserControl.Resources>
        <Style TargetType="Button"
               BasedOn="{StaticResource MetroButton}">
            <Setter Property="Width"
                    Value="110" />
            <Setter Property="Height"
                    Value="23" />
            <Setter Property="Margin"
                    Value="5" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <TextBlock TextWrapping="Wrap"
                   Margin="5"
                   Text="Camp mode anchors the bot to a single position instead of patrolling a route. It fights targets within the camp radius, returns to the camp point after every kill, and performs resting and trust summons at camp." />

        <CheckBox Margin="5"
                  Content="Enable camp mode (overrides route patrolling)"
                  IsChecked="{Binding IsCampEnabled}" />

        <StackPanel Orientation="Horizontal">
            <Button Content="Set Camp Here"
                    Command="{Binding SetCampCommand}" />
            <Button Content="Clear Camp"
                    Command="{Binding ClearCampCommand}" />
        </StackPanel>

        <TextBlock Margin="5"
                   FontWeight="Bold"
                   Text="{Binding CampDescription}" />

        <StackPanel Orientation="Horizontal"
                    Margin="5">
            <TextBlock VerticalAlignment="Center"
                       Text="Camp radius (yalms): " />
            <TextBox Width="60"
                     Text="{Binding CampRadius, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock TextWrapping="Wrap"
                   Margin="5"
                   Foreground="Gray"
                   Text="Tip: set the camp a little away from mob spawn points so respawns do not land on top of you, and set the radius to cover the spawns you want to farm." />
    </StackPanel>
</UserControl>
