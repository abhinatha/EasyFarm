<dialogs:CustomDialog x:Class="EasyFarm.Views.SelectProcessDialog"
        xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" Margin="20" Style="{StaticResource DialogStyle}">
    <dialogs:CustomDialog.DialogTop>
        <Grid Background="{StaticResource WindowTitleColorBrush}">
            <TextBlock 
                FontSize="{StaticResource DialogMessageFontSize}"
                Foreground="{StaticResource WhiteBrush}"
                Text="Available Processes"
                TextAlignment="Center"
                Margin="5"
            />
        </Grid>
    </dialogs:CustomDialog.DialogTop>
    <dialogs:CustomDialog.DialogBottom>
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Shuts down the process selection view. -->
            <Button Content="Set Character"
                    MinHeight="28"
                    Command="{Binding SelectCommand}" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    MinWidth="70"
                    MinHeight="28"
                    Margin="5 0 0 0"
                    Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2"
                    Content="Cancel"
                    MinWidth="70"
                    MinHeight="28"
                    Margin="5 0 0 0"
                    Command="{Binding CancelCommand}"/>
        </Grid>
    </dialogs:CustomDialog.DialogBottom>

    <dialogs:CustomDialog.Content>
        <!-- A view for currently running game sessions. -->
        <!-- MinHeight keeps the list usable when the host window is small;
             MaxHeight plus the built-in scroll viewer stops a long process
             list from pushing the button row off the bottom of the host. -->
        <ListView Name="LsvGameSessons"
                  MinHeight="180"
                  MaxHeight="400"
                  MinWidth="420"
                  Margin="0 5"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ItemsSource="{Binding Processes}"
                  SelectedItem="{Binding SelectedEntry}">
            <ListView.View>
                <!-- The headers for session information. Explicit widths: the
                     default auto-sizing collapses Character Name to the header
                     width, so long titles render as an empty-looking cell. -->
                <GridView>
                    <GridViewColumn Header="Process ID"
                                    Width="90"
                                    DisplayMemberBinding="{Binding Path=Id}" />
                    <GridViewColumn Header="Executable"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Path=ExecutableName}" />
                    <GridViewColumn Header="Memory (MB)"
                                    Width="90"
                                    DisplayMemberBinding="{Binding Path=MemoryMb}" />
                    <GridViewColumn Header="Window Title"
                                    Width="220"
                                    DisplayMemberBinding="{Binding Path=Title}" />
                </GridView>
            </ListView.View>
        </ListView>
    </dialogs:CustomDialog.Content>
</dialogs:CustomDialog>
